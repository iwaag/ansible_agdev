{% set source = autolab_node_plane_credentials_source %}
{# Credentials only (multi-project Plane): the project UUID and its state
   IDs travel in each mission's text — state IDs are per-project, so pinned
   copies here would be wrong for every project but one. #}
{% for key in [
  'PLANE_URL',
  'PLANE_API_KEY',
  'PLANE_WORKSPACE_SLUG'
] %}
{{ key }}={{ lookup('ansible.builtin.ini', key ~ ' type=properties file=' ~ source) | trim | to_json }}
{% endfor %}
