[Unit]
Description=OpenCode node agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ opencode_agent_workdir }}
ExecStart={{ opencode_agent_bin }} serve --hostname {{ opencode_agent_listen }} --port {{ opencode_agent_port }}
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
