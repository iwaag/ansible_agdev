<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clusterintent.opencode.agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{ opencode_agent_bin }}</string>
    <string>serve</string>
    <string>--hostname</string>
    <string>{{ opencode_agent_listen }}</string>
    <string>--port</string>
    <string>{{ opencode_agent_port }}</string>
  </array>
  <key>WorkingDirectory</key>
  <string>{{ opencode_agent_workdir }}</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
</dict>
</plist>
